{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"correctness": {
				"useJsxKeyInIterable": "on"
			},
			"nursery": {
				"useTailwindSortedClasses": "warn"
			}
		}
	},
	"assist": {
		"enabled": true
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!.claude",
			"!.wrangler",
			"!dist",
			"!dist-server",
			"!node_modules"
		]
	}
}
