{
	"name": "learn",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "$npm_execpath run build && vite preview",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"format": "biome check --write --unsafe"
	},
	"dependencies": {
		"@cloudensis/design-system": "^0.7.0",
		"hono": "^4.13.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@cloudflare/vite-plugin": "^1.54.10",
		"@tailwindcss/vite": "^4.3.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vite-ssr-components": "^0.8.0",
		"wrangler": "^4.132.0"
	},
	"imports": {
		"#/*": [
			"./*.ts",
			"./*.tsx",
			"./*"
		]
	}
}
