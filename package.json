{
	"name": "learn",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build && node scripts/ssg.ts",
		"preview": "$npm_execpath run build && wrangler dev",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"format": "biome check --write --unsafe"
	},
	"dependencies": {
		"@cloudensis/design-system": "^0.14.1",
		"hono": "^4.13.13"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@hono/vite-dev-server": "^0.26.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.3",
		"vite-ssr-components": "^0.8.0",
		"wrangler": "^4.148.0"
	},
	"imports": {
		"#/*": [
			"./*.ts",
			"./*.tsx",
			"./*"
		]
	}
